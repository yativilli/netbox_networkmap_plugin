#: network_map/coverage.py:36
msgid "Sites and coordinates"
msgstr "Standorte und Koordinaten"

#: network_map/coverage.py:37
msgid "VLANs and prefixes"
msgstr "VLANs und Präfixe"

#: network_map/coverage.py:38
msgid "IP addresses"
msgstr "IP-Adressen"

#: network_map/coverage.py:39
msgid "Machine placement"
msgstr "Standort der Maschinen"

#: network_map/coverage.py:40
msgid "Rooms and floors"
msgstr "Räume und Etagen"

#: network_map/coverage.py:41
msgid "Gateways"
msgstr "Gateways"

#: network_map/coverage.py:45
msgid "Blocking"
msgstr "Blockierend"

#: network_map/coverage.py:46
msgid "Warning"
msgstr "Warnung"

#: network_map/coverage.py:47
msgid "Information"
msgstr "Information"

#: network_map/coverage.py:122
msgid "Site name is not present in NetBox"
msgstr "Der Standortname fehlt in NetBox"

#: network_map/coverage.py:124
msgid ""
"Machines point to this site name, but the subnet map cannot place them "
"unless a Site with the same name exists."
msgstr ""
"Die Maschinen verweisen auf diesen Standortnamen, die Subnetzkarte kann sie "
"aber erst platzieren, wenn ein Site mit demselben Namen existiert."

#: network_map/coverage.py:127 network_map/coverage.py:145
#: network_map/coverage.py:164 network_map/coverage.py:181
#: network_map/templates/network_map/data_coverage.html:106
msgid "Site"
msgstr "Standort"

#: network_map/coverage.py:140
msgid "Site name is ambiguous"
msgstr "Der Standortname ist mehrdeutig"

#: network_map/coverage.py:142
msgid ""
"Several sites share this name. Rename them or map machines by site so the "
"map can choose the right one."
msgstr ""
"Mehrere Standorte haben denselben Namen. Benennen Sie sie um oder ordnen Sie "
"die Maschinen einem Standort zu, damit die Karte den richtigen erkennt."

#: network_map/coverage.py:159
msgid "No coordinates for a site with machines"
msgstr "Keine Koordinaten für einen Standort mit Maschinen"

#: network_map/coverage.py:161
msgid ""
"Add latitude and longitude on the Site, or fill in an address so geocoding "
"can find it later."
msgstr ""
"Erfassen Sie Breite und Länge beim Site oder ergänzen Sie eine Adresse, "
"damit das Geocoding sie später finden kann."

#: network_map/coverage.py:176
msgid "City cannot be inferred from the site"
msgstr "Die Stadt lässt sich aus dem Standort nicht ableiten"

#: network_map/coverage.py:178
msgid ""
"Floor-plan filtering by city cannot find this site. Put the city in the site "
"name or physical address."
msgstr ""
"Die Filterung der Etagenpläne nach Stadt findet diesen Standort nicht. "
"Schreiben Sie die Stadt in den Standortnamen oder die physische Adresse."

#: network_map/coverage.py:199
msgid "VLAN has no prefix"
msgstr "VLAN ohne Präfix"

#: network_map/coverage.py:201
msgid ""
"Machines are collected from IP addresses inside related prefixes, so a VLAN "
"without a prefix stays empty."
msgstr ""
"Die Maschinen werden aus IP-Adressen in den zugehörigen Präfixen gesammelt, "
"ein VLAN ohne Präfix bleibt deshalb leer."

#: network_map/coverage.py:204 network_map/svg_render/logical_tree.py:72
#: network_map/views.py:659
msgid "VLAN"
msgstr "VLAN"

#: network_map/coverage.py:234
msgid "Prefix has no active or reserved IP addresses"
msgstr "Präfix ohne aktive oder reservierte IP-Adressen"

#: network_map/coverage.py:236
msgid ""
"The map will show this prefix only as an empty subnet unless an active or "
"reserved IP address is inside it."
msgstr ""
"Die Karte zeigt dieses Präfix nur als leeres Subnetz, solange keine aktive "
"oder reservierte IP-Adresse darin liegt."

#: network_map/coverage.py:239 network_map/svg_render/logical_tree.py:86
#: network_map/svg_render/logical_tree.py:88
#: network_map/templates/network_map/vlan_connection.html:73
#: network_map/views.py:656
msgid "Prefix"
msgstr "Präfix"

#: network_map/coverage.py:272
msgid "IP address has no DNS name"
msgstr "IP-Adresse ohne DNS-Namen"

#: network_map/coverage.py:274
msgid ""
"The current machine collection only picks up IP addresses with a DNS name."
msgstr "Es werden nur IP-Adressen mit einem DNS-Namen als Maschinen erfasst."

#: network_map/coverage.py:277 network_map/coverage.py:293
#: network_map/coverage.py:310
msgid "IP address"
msgstr "IP-Adresse"

#: network_map/coverage.py:288
msgid "IP address has a blank DNS name"
msgstr "IP-Adresse mit leerem DNS-Namen"

#: network_map/coverage.py:290
msgid ""
"The machine list falls back to names or descriptions, which is harder to "
"read than a real DNS name."
msgstr ""
"Die Maschinenliste fällt auf Namen oder Beschreibungen zurück, die "
"schlechter lesbar sind als ein echter DNS-Name."

#: network_map/coverage.py:305
msgid "IP address has no device or virtual machine"
msgstr "IP-Adresse ohne Gerät oder virtuelle Maschine"

#: network_map/coverage.py:307
msgid ""
"Assign the address to an interface if it represents a machine that should "
"appear on the map."
msgstr ""
"Weisen Sie die Adresse einer Schnittstelle zu, wenn sie eine Maschine "
"darstellt, die auf der Karte erscheinen soll."

#: network_map/coverage.py:323
msgid "Assigned machine has no site"
msgstr "Die zugewiesene Maschine hat keinen Standort"

#: network_map/coverage.py:325
msgid ""
"Give the device or virtual machine a site, otherwise the subnet map cannot "
"place it."
msgstr ""
"Weisen Sie dem Gerät oder der virtuellen Maschine einen Standort zu, sonst "
"kann die Subnetzkarte sie nicht platzieren."

#: network_map/coverage.py:328 network_map/coverage.py:380
#: network_map/templates/network_map/vlan_topology.html:21
msgid "Machine"
msgstr "Maschine"

#: network_map/coverage.py:341
msgid "Physical machine has no room"
msgstr "Physische Maschine ohne Raum"

#: network_map/coverage.py:343
msgid ""
"Set the device location, or a rack location, so the floor plan can put the "
"machine in a room."
msgstr ""
"Erfassen Sie den Geräte-Standort oder einen Rack-Standort, damit der "
"Etagenplan die Maschine einem Raum zuordnen kann."

#: network_map/coverage.py:346
msgid "Device"
msgstr "Gerät"

#: network_map/coverage.py:375
msgid "Machine is not attached to a site"
msgstr "Maschine ist keinem Standort zugeordnet"

#: network_map/coverage.py:377
msgid ""
"It stays in the unplaced list because neither the assigned object nor the IP "
"gives a site."
msgstr ""
"Sie bleibt in der Liste der nicht platzierten Maschinen, weil weder das "
"zugewiesene Objekt noch die IP einen Standort liefert."

#: network_map/coverage.py:418
msgid "Floor cannot be inferred from the room name"
msgstr "Die Etage lässt sich aus dem Raumnamen nicht ableiten"

#: network_map/coverage.py:420
msgid ""
"The floor plan will place this room under \"Other rooms\". Use a name such "
"as \"2. Stock - Gang\", \"EG 12\", or \"OG 2\" to make the floor readable."
msgstr ""
"Der Etagenplan zeigt diesen Raum unter \"Weitere Räume\". Verwenden Sie "
"einen Namen wie \"2. Stock - Gang\", \"EG 12\" oder \"OG 2\", damit die "
"Etage erkennbar bleibt."

#: network_map/coverage.py:424 network_map/coverage.py:444
#: network_map/svg_render/logical_tree.py:58
#: network_map/svg_render/logical_tree.py:120
#: network_map/svg_render/machine_list.py:26
#: network_map/templates/network_map/vlan_element_list.html:68
#: network_map/views.py:654
msgid "Location"
msgstr "Standort"

#: network_map/coverage.py:439
msgid "Room has no machines"
msgstr "Raum ohne Maschinen"

#: network_map/coverage.py:441
msgid ""
"The room will be drawn, but it carries no physical machine from the current "
"IP data."
msgstr ""
"Der Raum wird gezeichnet, enthält aber keine physische Maschine aus den "
"aktuellen IP-Daten."

#: network_map/coverage.py:462
msgid "Gateway search tag is not configured"
msgstr "Gateway-Such-Tag ist nicht konfiguriert"

#: network_map/coverage.py:464
msgid ""
"Set the network_map gateway_search_tag plugin setting to the tag used for "
"gateway IP addresses."
msgstr ""
"Setzen Sie die Plugin-Einstellung network_map gateway_search_tag auf das Tag "
"der Gateway-IP-Adressen."

#: network_map/coverage.py:467
msgid "Setting"
msgstr "Einstellung"

#: network_map/coverage.py:480
msgid "Gateway search failed"
msgstr "Die Gateway-Suche ist fehlgeschlagen"

#: network_map/coverage.py:482 network_map/coverage.py:498
#: network_map/coverage.py:514
msgid "Tag"
msgstr "Tag"

#: network_map/coverage.py:493
msgid "No gateway-tagged objects were found"
msgstr "Keine Objekte mit Gateway-Tag gefunden"

#: network_map/coverage.py:495
msgid ""
"The logical connection view starts from objects tagged with the configured "
"gateway tag."
msgstr ""
"Die logische Verbindungsansicht geht von Objekten aus, die mit dem "
"konfigurierten Gateway-Tag markiert sind."

#: network_map/coverage.py:509
msgid "Gateway search tag does not match a tag object"
msgstr "Das Gateway-Such-Tag entspricht keinem Tag-Objekt"

#: network_map/coverage.py:511
msgid ""
"The search found text matches, but no tag with this exact name exists. Check "
"the plugin setting or create the tag."
msgstr ""
"Die Suche hat Texttreffer gefunden, aber es existiert kein Tag mit genau "
"diesem Namen. Prüfen Sie die Plugin-Einstellung oder erstellen Sie das Tag."

#: network_map/coverage.py:530
msgid "Gateway-tagged object is not usable on the logical map"
msgstr "Gateway-Objekt ist für die logische Ansicht nicht verwendbar"

#: network_map/coverage.py:532
msgid "The logical map needs an IP address whose prefix has a VLAN assigned."
msgstr ""
"Die logische Ansicht braucht eine IP-Adresse, deren Präfix ein VLAN "
"zugewiesen ist."

